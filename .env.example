# Laravel API base URL (without /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Development only: use a mock Telegram environment in a regular browser.
# Requires TELEGRAM_DEV_AUTH_ENABLED=true on the (local) backend.
NEXT_PUBLIC_TELEGRAM_MOCK=false
